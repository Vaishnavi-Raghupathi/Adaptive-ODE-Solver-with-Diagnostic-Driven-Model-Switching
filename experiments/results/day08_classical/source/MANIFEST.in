include LICENSE README.md pytest.ini requirements-research.in requirements-research.lock requirements-dev.lock
include app.py legacy_app.py
recursive-include docs *.md
recursive-include examples *.py *.csv
recursive-include tests *.py
recursive-include experiments/configs *.json
recursive-include .github/workflows *.yml
prune experiments/results
global-exclude __pycache__ *.py[cod] .DS_Store
