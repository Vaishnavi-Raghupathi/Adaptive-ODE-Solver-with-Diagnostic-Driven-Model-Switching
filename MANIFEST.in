include LICENSE README.md CHANGELOG.md CONTRIBUTING.md pytest.ini requirements-research.in requirements-research.lock requirements-dev.lock
include app.py legacy_app.py
include requirements.txt requirements-legacy.txt
recursive-include docs *.md
recursive-include examples *.py *.csv *.json
recursive-include tests *.py
recursive-include experiments/configs *.json
recursive-include .github/workflows *.yml
recursive-include .streamlit *.toml
prune experiments/results
global-exclude __pycache__ *.py[cod] .DS_Store
